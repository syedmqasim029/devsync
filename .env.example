# ==============================================================================
# DevSync — Environment Configuration Template
# Copy this file to .env and populate with your credentials for local or cloud deployment.
# ==============================================================================

# 1. Google Gemini API Key (Server-Side Only — used by /api/ai/analyze-setup with gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub Personal Access Token (Optional but strongly recommended for 5,000 req/hr & GraphQL telemetry)
GITHUB_TOKEN=your_github_personal_access_token_here

# 3. GitHub OAuth 2.0 Credentials (Optional — enables 1-click GitHub OAuth popup sign-in)
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# 4. Session & CSRF Encryption Secret (32+ random characters recommended in production)
SESSION_SECRET=replace_with_32_byte_random_hex_secret_in_production

# 5. Public Application URL & Allowed CORS Origins
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
